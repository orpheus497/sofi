/**
 * sofi built-in panel: window / task manager
 *
 * A floating strip near the bottom edge of the output. Selected automatically
 * when sofi runs in window mode; no user config required.
 *
 * Two zones, left to right: a fixed-width filter field and the task strip
 * itself, separated by spacing rather than by a box so the bar reads as one
 * object.
 *
 * The right-hand zone is deliberately absent rather than empty. It carried a
 * matched/total window count until DECISIONS_LOG R38, which removed it on
 * USER's explicit instruction and reserves the corner for the system tray.
 * Shipping an empty zone in the meantime would draw its hairline separator
 * with nothing after it.
 *
 * `layout: horizontal` selects the listview's BARVIEW renderer, which sizes
 * each element to its own content width and scrolls the visible window as the
 * selection moves. That is what makes this read as a task strip rather than a
 * grid -- `flow: horizontal` would divide the width into equal cells instead.
 *
 * Colours come from /org/sofi/palette.sasi, parsed immediately before this
 * file. There are deliberately no colour values here.
 */

configuration {
    show-icons:                 true;

    /* Action purpose: lead with the title, because that is what distinguishes
     * two windows of the same application -- the old "{c} · {t:28}" led with
     * the one field every row of an application shares. `{t:24}` both caps and
     * pads to 24 characters, which is what puts the class at the same column
     * on every chip; the class itself is demoted with `alpha` rather than a
     * colour so it follows the row's own text colour when selected.
     *
     * Both backends escape these values and set MARKUP, so a window titled
     * "<b>" is rendered, not parsed. */
    window-format:              "{t:24} <span size='small' alpha='50%'>{c}</span>";

    window {
        /* A task strip should survive closing a window -- otherwise closing
         * three of them means summoning the bar three times. */
        close-on-delete:        false;
    }
}

* {
    background-color:            transparent;
    text-color:                  @foreground;
    margin:                      0;
    padding:                     0;
    spacing:                     0;
}

window {
    enabled:                     true;
    location:                    south;
    anchor:                      south;

    /* Not 100%: an inset strip reads as an object floating over the desktop,
       which is what the rounded corners are for. At 100% the side radii would
       be off-screen and the bar would read as a slab welded to the edge. */
    width:                       98%;
    x-offset:                    0px;

    /* Action purpose: POSITIVE is inward here. This surface covers the whole
       usable area to catch outside clicks, so the panel is placed inside it in
       software and the offset moves it away from the anchored edge
       (wayland/view.c, window_update_size_with_outside_click). The daemon's
       banner takes the other path -- layer-shell margins -- where the same
       intent is written as a NEGATIVE number. This was -12px and put the
       bottom 12px of the strip outside the usable area. */
    y-offset:                    12px;

    border:                      0px;
    border-radius:               14px;
    background-color:            @background;
    padding:                     8px 12px;
}

/* Horizontal so type-to-filter stays available: dropping the inputbar
   entirely would leave state->text NULL and silently disable filtering. */
mainbox {
    enabled:                     true;
    orientation:                 horizontal;
    spacing:                     12px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    expand:                      false;
    orientation:                 horizontal;
    padding:                     6px 10px;
    spacing:                     8px;
    background-color:            @surface;
    border-radius:               10px;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @accent-soft;
    vertical-align:              0.5;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Filter";
    placeholder-color:           @hint;
    cursor-color:                @accent;
    cursor-width:                2px;
    vertical-align:              0.5;
    width:                       150px;
}

listview {
    enabled:                     true;
    layout:                      horizontal;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    spacing:                     6px;
    background-color:            transparent;
}

/* See the note in doc/default_theme.sasi: the leading border is on every
   element, transparent until selected, so selecting a chip does not shift its
   contents sideways. */
element {
    enabled:                     true;
    orientation:                 horizontal;
    padding:                     7px 12px;
    spacing:                     9px;
    border:                      0px 0px 0px 3px;
    border-color:                transparent;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal, element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

/* Windows living on a sheet other than the one being displayed arrive with
   the foreign-toplevel `minimized` bit set -- hikari publishes its `hidden`
   flag through it. Render them muted so the strip does not claim they are in
   front of you. `foreground-dim` rather than `muted`: this is text, and
   `muted` is 2.29:1 against the ground. */
element normal.urgent, element alternate.urgent {
    text-color:                  @foreground-dim;
}

element normal.active, element alternate.active {
    text-color:                  @accent-strong;
}

/* Action purpose: a highlighted off-sheet window is still the highlighted row,
   so it takes the selection treatment like any other. Grouping it with the
   muted normal.urgent rule above left the cursor invisible whenever it landed
   on a window from another sheet. */
element selected.normal, element selected.active, element selected.urgent {
    background-color:            @accent;
    border-color:                @accent-strong;
    text-color:                  @on-accent;
}

element-icon {
    background-color:            transparent;
    size:                        20px;
    vertical-align:              0.5;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    cursor:                      inherit;
}

/* The window count that lived here is gone (R38). The system tray takes this
   corner; its zone is added when the tray lands, not reserved empty now. */
