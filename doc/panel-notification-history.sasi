/**
 * sofi built-in panel: notification history
 *
 * The whole ring buffer, live and retired. Unlike the banner this is a menu
 * the user summoned deliberately, so it behaves like the other menus: it takes
 * the keyboard, it filters, and clicking outside dismisses it.
 *
 * Right edge rather than a corner, because it is a list the user reads rather
 * than a stack that appears beside their work.
 *
 * Colour variables are inlined because @import cannot resolve from inside a
 * GResource.
 */

configuration {
    show-icons:                 true;
    /* Two-line rows: heading above, body below. See the note in
       panel-notifications.sasi. */
    eh:                         2;
}

* {
    background:      #000000BF; /* 75% Opacity */
    background-alt:  #101010;
    foreground:      #FFFFFF;
    accent:          #916778; /* Powdery Red/Purple Blend (Dusty Mauve) */
    critical:        #C25A5A;
    dimmed:          #6E6268;
}

* {
    background-color:            transparent;
    text-color:                  @foreground;
    margin:                      0;
    padding:                     0;
    spacing:                     0;
}

window {
    enabled:                     true;
    location:                    east;
    anchor:                      east;
    width:                       460px;
    height:                      80%;
    x-offset:                    -14px;
    y-offset:                    0px;

    border:                      0px;
    border-radius:               12px;
    background-color:            @background;
    padding:                     16px;
}

mainbox {
    enabled:                     true;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    padding:                     10px 12px;
    margin:                      0px 0px 12px 0px;
    background-color:            @background-alt;
    border-radius:               8px;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @accent;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Search notifications…";
    placeholder-color:           #444444;
    margin:                      0px 0px 0px 10px;
}

listview {
    enabled:                     true;
    layout:                      vertical;
    columns:                     1;
    lines:                       12;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    spacing:                     4px;
    background-color:            transparent;
}

scrollbar {
    handle-width:                4px;
    handle-color:                @accent;
    background-color:            @background-alt;
    border-radius:               2px;
}

element {
    enabled:                     true;
    orientation:                 horizontal;
    padding:                     10px 12px;
    spacing:                     10px;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @dimmed;
    cursor:                      pointer;
}

/* Retired entries: the common case in a history list, so they are the muted
   default rather than a special state. */
element normal.normal, element alternate.normal {
    background-color:            transparent;
    text-color:                  @dimmed;
}

/* Still on screen right now. */
element normal.active, element alternate.active {
    text-color:                  @foreground;
}

/* Critical, and already retired. */
element normal.urgent, element alternate.urgent {
    text-color:                  @critical;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color:            @accent;
    text-color:                  #FFFFFF;
}

element-icon {
    background-color:            transparent;
    size:                        24px;
    vertical-align:              0.0;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.0;
    horizontal-align:            0.0;
    cursor:                      inherit;
}
