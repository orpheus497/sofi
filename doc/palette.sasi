/**
 * sofi palette -- the only file in this tree that contains a colour value.
 *
 * Parsed from the GResource immediately before whichever built-in panel layout
 * the invocation selected, so every surface draws from one set of names. The
 * layouts themselves contain no hex at all; change a value here and all six
 * follow.
 *
 * ---------------------------------------------------------------------------
 * ONE PALETTE, TWO PROGRAMS
 *
 * The sixteen positional slots below are byte-identical to hikari-sakura's
 * `ui { palette }` block, and the semantic names beneath them are mapped onto
 * that compositor's own `ui { colorscheme }` slot by slot:
 *
 *     sofi accent        = color12 = hikari `selected`
 *     sofi accent-soft   = color4  = hikari `first`
 *     sofi accent-strong = color13 = hikari `insert`
 *     sofi urgent        = color9  = hikari `conflict`
 *     sofi muted         = color8  = hikari `inactive`
 *     sofi background    = color0 @ 90% = hikari `bar`, exactly
 *
 * That last one is why a sofi panel sitting under the top bar reads as the same
 * surface rather than as a window laid over it. The layout is the conventional
 * terminal one -- 0-7 normal, 8-15 bright -- which is what lets one sixteen
 * value scheme dress the compositor, its bar and this shell at once, and what
 * makes a terminal colorscheme droppable in wholesale.
 *
 * ---------------------------------------------------------------------------
 * OVERRIDING IT
 *
 * `@` references resolve at property lookup, not at parse, and every parse has
 * finished before the first widget is built. So a `* { }` block in
 * ~/.config/sofi/config.sasi is parsed after this file and still wins -- for
 * every surface at once. Redefining `color12` recolours all four panels;
 * redefining `accent` recolours their selections without touching anything else
 * that happens to use color12. See sofi-customisation(5).
 */

/* ===================================================================
 * POSITIONAL SLOTS
 *
 * These have no meaning on their own. Nothing in a layout refers to a colorN
 * directly -- the semantic names below are the interface, and this is the
 * implementation.
 * =================================================================== */
* {
    color0:   #2b1e3a;  /* base          */
    color1:   #c96464;  /* red           */
    color2:   #df9f87;  /* orange        */
    color3:   #e4b382;  /* yellow        */
    color4:   #8e7cc3;  /* violet        */
    color5:   #b18fc7;  /* mauve         */
    color6:   #9fa0a6;  /* grey          */
    color7:   #d4d4d9;  /* text          */

    color8:   #5e5966;  /* bright base   */
    color9:   #df8787;  /* bright red    */
    color10:  #f2bda8;  /* bright orange */
    color11:  #f5cf9e;  /* bright yellow */
    color12:  #aba0d9;  /* bright violet */
    color13:  #cfaedc;  /* bright mauve  */
    color14:  #b8b9be;  /* bright grey   */
    color15:  #f0edf2;  /* bright text   */
}

/* ===================================================================
 * DERIVED TONES
 *
 * A `@colorN` reference carries the slot's value and nothing else: the format
 * has no operator for applying alpha to one, and no blend. The six values below
 * are therefore written as literals, each annotated with the slot it comes from
 * so a palette change tells you exactly which ones need recomputing. This is
 * the same compromise hikari.conf makes for its `bar` slot, for the same
 * reason.
 * =================================================================== */
* {
    /* color0 at 90%. Identical to hikari's `bar`, deliberately. */
    background:        #2b1e3ae6;

    /* The same ground with no transparency, for the notification cards: a
     * banner lands over arbitrary content and must not have that content
     * showing through the text. */
    background-solid:  @color0;

    /* color0 blended 25% toward color8. Inset fields -- the filter box, the
     * scrollbar trough. Only 1.21:1 against the ground, which is the point: it
     * should read as a recess, not as a second panel. */
    surface:           #382d45;

    /* The same blend at 50%, for a field that sits on `surface` rather than on
     * the ground. */
    surface-alt:       #443c50;

    /* color8 at 60%. Hairline separators between zones. */
    border-soft:       #5e596699;

    /* color0 blended 70% toward color6. Placeholder text, at 3.66:1 -- legible
     * as a hint without competing with what the user types over it. Named
     * `hint` rather than `placeholder` on purpose: `placeholder` and
     * `placeholder-color` are real textbox properties, and a global of that
     * name would be found by the widget's own lookup, fail the type check, and
     * silently suppress the placeholder text. */
    hint:              #7c7986;
}

/* ===================================================================
 * SEMANTIC NAMES -- what each colour is FOR
 *
 * This is what the layouts refer to. The contrast ratio against the ground is
 * recorded for every one that carries text, because two of them do not clear
 * WCAG AA for body copy and that is a constraint on where they may be used,
 * not a matter of taste.
 * =================================================================== */
* {
    /* Body text. 10.54:1. Not color15 -- holding the brightest tone back is
     * what gives a list somewhere to escalate to. */
    foreground:        @color7;

    /* Emphasis: a selected row's label, a live notification's summary.
     * 13.41:1. */
    foreground-bright: @color15;

    /* Secondary metadata -- app names, timestamps, window classes, counts.
     * 5.97:1, so it is still body-legible; it recedes by being cooler and
     * smaller, not by being too faint to read. */
    foreground-dim:    @color6;

    /* 2.29:1. NON-TEXT ONLY -- separators, scrollbar troughs, disabled fills,
     * the empty half of a meter. Putting a label in this colour is the one way
     * to make this palette unreadable; use `hint` or `foreground-dim`. */
    muted:             @color8;

    /* Selection. Same slot as hikari's focused-window marker, so a highlighted
     * row and a focused window agree about what "chosen" looks like. 6.49:1 as
     * text on the ground. */
    accent:            @color12;

    /* Prompts, leading stripes, hover. 4.31:1 -- AA for large or bold text and
     * for the non-text marks it is mostly used as, but not for body copy. */
    accent-soft:       @color4;

    /* The current sheet, a still-live notification. 7.96:1. */
    accent-strong:     @color13;

    /* Text drawn ON an accent fill. color0, not white: white on color12 is
     * 2.40:1 and unreadable, while this is 6.49:1. The single most important
     * pair in the file. */
    on-accent:         @color0;

    /* Critical urgency as text. 5.89:1. */
    urgent:            @color9;

    /* Critical urgency as a fill or a stripe. 4.07:1 as text, so it is not for
     * text -- `urgent` is. */
    critical:          @color1;

    /* Unread counts, truncation markers, anything that wants attention without
     * claiming to be an error. 10.60:1. */
    warning:           @color11;
}
