#!/usr/bin/env bash
#
# This code is released in public domain by Dave Davenport <qball@gmpclient.org>
#

##
# OS checking code as utilities could be different
##
OS="gnu"
case "$OSTYPE" in
    *linux*|*hurd*|*msys*|*cygwin*|*sua*|*interix*) OS="gnu";;
    *bsd*|*darwin*) OS="bsd";;
    *sunos*|*solaris*|*indiana*|*illumos*|*smartos*) OS="sun";;
esac

SOFI=$(command -v sofi)
if [ $OS = "bsd" ]; then
    SED=$(command -v gsed)
else
    SED=$(command -v sed)
fi
GREP=$(command -v grep)
MKTEMP=$(command -v mktemp)

if [ -z "${SED}" ]
then
    echo "Did not find 'sed', script cannot continue."
    exit 1
fi
if [ -z "${MKTEMP}" ]
then
    echo "Did not find 'mktemp', script cannot continue."
    exit 1
fi
if [ -z "${SOFI}" ]
then
    echo "Did not find sofi, there is no point to continue."
    exit 1
fi

# Action purpose: appending an extension to mktemp's output names a *different*
# file than the one mktemp safely created — the real target is predictable and
# unprotected, and the secure file is leaked. Create a 0700 directory instead
# and put the suffixed file inside it.
TMP_CONFIG_DIR=$(${MKTEMP} -d)
if [ -z "${TMP_CONFIG_DIR}" ] || [ ! -d "${TMP_CONFIG_DIR}" ]
then
    echo "Failed to create a temporary directory."
    exit 1
fi
trap 'rm -rf -- "${TMP_CONFIG_DIR}"' EXIT INT TERM
TMP_CONFIG_FILE="${TMP_CONFIG_DIR}/theme.lua"

##
# Array with parts to the found themes.
# And array with the printable name.
##
declare -a themes
declare -a theme_names

##
# Function that tries to find all installed sofi themes.
# This fills in #themes array and formats a displayable string #theme_names
##
find_themes()
{
    DIRS=${XDG_DATA_DIRS}
    OLDIFS=${IFS}
    IFS=:
    if [ -z "${XDG_DATA_DIRS}" ]
    then
        echo "XDG_DATA_DIRS needs to be set for this script to function correctly."
        echo -n "Using dirs from \$PATH: "
        DIRS=
        # Iterate over items in $PATH
        for p in ${PATH}; do
            # Remove trailing / if exists.
            x=${p%/}
            # remove both /bin and /sbin and /games from end
            x=${x%/bin}
            x=${x%/sbin}
            x=${x%/games}
            # Add /share
            x=${x}/share
            # Check if entry exists Prepend : so :${x}: matches nicely
            case ":${DIRS}" in
                *$x:*);;
                *) DIRS+="$x:";;
            esac
        done
        # Remove trailing :
        DIRS=${DIRS%:}
        echo "${DIRS}"
    fi
    # Add user dir.
    DIRS+=":${XDG_DATA_HOME:-${HOME}/.local/share}"
    DIRS+=":${XDG_CONFIG_HOME:-${HOME}/.config}"
    for p in ${DIRS}; do
        p=${p%/}
        TD=${p}/sofi/themes
        if [ -n "${p}" ] && [ -d "${TD}" ]
        then
            echo "Checking themes in: ${TD}"
            for file in ${TD}/*.lua
            do
                if [ -f "${file}" ]
                then
                    themes+=("${file}")
                    FN=$(basename "${file}")
                    NAME=${FN%.*}
                    USER=$(${SED} -n 's/^.*User: \(.*\)/\1/p' "${file}" | head -n 1 )
                    if [ -z "${USER}" ]
                    then
                        theme_names+=(${NAME})
                    else
                        theme_names+=("${NAME} by ${USER}")
                    fi
                fi
           done
        fi
    done
    IFS=${OLDIFS}
}

##
# Create a copy of sofi
##
create_config_copy()
{
    ${SOFI} -dump-config > "${TMP_CONFIG_FILE}"
    # The dumped config spells an option `name = value,`; the theme is set by
    # the region set_theme() owns, not by this option, so it is stripped from
    # the preview copy exactly as it was before.
    ${SED} -i '/^[[:space:]]*theme[[:space:]]*=[[:space:]]*".*",\?[[:space:]]*$/d' "${TMP_CONFIG_FILE}"
}

###
# Print the list out so it can be displayed by sofi.
##
create_theme_list()
{
    OLDIFS=${IFS}
    IFS='|'
    for themen in ${theme_names[@]}
    do
        echo "${themen}"
    done
    IFS=${OLDIFS}
}

##
# Thee indicate what entry is selected.
##
declare -i SELECTED

select_theme()
{
    local MORE_FLAGS=(-dmenu -format i -no-custom -p "Theme" -markup -config "${TMP_CONFIG_FILE}" -i)
    MORE_FLAGS+=(-kb-custom-1 "Alt-a")
    MORE_FLAGS+=(-u 2,3 -a 4,5 )
    local CUR="default"
    while true
    do
        declare -i RTR
        declare -i RES
        local MESG="""You can preview themes by hitting <b>Enter</b>.
<b>Alt-a</b> to accept the new theme.
<b>Escape</b> to cancel
Current theme: <b>${CUR}</b>
<span weight=\"bold\" size=\"xx-small\">When setting a new theme this will override previous theme settings.
Please update your config file if you have local modifications.</span>"""
        THEME_FLAG=
        if [ -n "${SELECTED}" ]
        then
            THEME_FLAG="-theme ${themes[${SELECTED}]}"
        fi
        RES=$( create_theme_list | ${SOFI} ${THEME_FLAG} ${MORE_FLAGS[@]} -cycle -selected-row "${SELECTED}" -mesg "${MESG}")
        RTR=$?
        if [ "${RTR}" = 10 ]
        then
            return 0;
        elif [ "${RTR}" = 1 ]
        then
            return 1;
        elif [ "${RTR}" = 65 ]
        then
            return 1;
        fi
        CUR=${theme_names[${RES}]}
        SELECTED=${RES}
    done
}

###
# Record the selected theme in the user's config, in a region this script owns
# so that repeated calls replace the choice instead of stacking choices up.
#
# A config is a Lua chunk returning an array of directives, so the selection has
# to go INSIDE that array: a line appended after the closing brace is
# unreachable, which is what appending to the old format's config did and which
# would silently do nothing here. The region is therefore written just before
# the chunk's final closing brace, and a `reset` directive precedes the import
# for the reason the old `@theme` carried one -- the selected theme replaces
# what came before it rather than merging with it.
#
# The one assumption is that the file ends with a line that is just `}`, which
# is true of the shipped config and of anything `sofi -dump-theme` produces. A
# file that does not is left completely alone and the user is told what to add,
# because a config this script cannot read is not a config it should rewrite.
###
set_theme()
{
    CDIR="${XDG_CONFIG_HOME:-${HOME}/.config}/sofi"
    if [ ! -d "${CDIR}" ]
    then
        mkdir -p "${CDIR}"
    fi
    # on BSD & MacOS readlink acts differently
    if [ $OS = "bsd" ]; then
        get_link="$(realpath "${CDIR}")/config.lua"
    else
        get_link=$(readlink -f "${CDIR}/config.lua")
    fi
    if [[ ! -f "${get_link}" ]]
    then
        printf '%s\n' \
            'return {' \
            '  -- sofi-theme-selector: begin' \
            '  -- sofi-theme-selector: end' \
            '}' > "${get_link}"
    fi

    BEGIN_MARK='  -- sofi-theme-selector: begin'
    END_MARK='  -- sofi-theme-selector: end'

    if ! ${GREP} -q -- '-- sofi-theme-selector: end' "${get_link}"
    then
        # No region yet. Open one immediately before the last line that is just
        # a closing brace, which is the end of the returned array.
        LAST_BRACE=$(${GREP} -n '^[[:space:]]*}[[:space:]]*$' "${get_link}" | tail -n 1 | cut -d: -f1)
        if [ -z "${LAST_BRACE}" ]
        then
            echo "Cannot find the end of the array in ${get_link}."
            echo "Add this inside the table it returns, then select again:"
            echo "  { reset = true }, import(\"${1}\"),"
            return 1
        fi
        ${SED} -i "${LAST_BRACE}i\\
${BEGIN_MARK}\\
${END_MARK}" "${get_link}"
    fi

    # Replace whatever is between the markers with this selection.
    ${SED} -i "/-- sofi-theme-selector: begin/,/-- sofi-theme-selector: end/{
/-- sofi-theme-selector: begin/!{/-- sofi-theme-selector: end/!d}
}" "${get_link}"
    ${SED} -i "/-- sofi-theme-selector: begin/a\\
  { reset = true }, import(\"${1}\")," "${get_link}"
}

############################################################################################################
# Actual program execution
###########################################################################################################
##
# Find all themes
##
find_themes

##
# Do check if there are themes.
##
if [ ${#themes[@]} = 0 ]
then
    ${SOFI} -e "No themes found."
    exit 0
fi

##
# Create copy of config to play with in preview
##
create_config_copy

##
# Show the themes to user.
##
if select_theme && [ -n "${SELECTED}" ]
then
    # Set theme
    set_theme "${themes[${SELECTED}]}"
fi

##
# Remove temp. config.
##
